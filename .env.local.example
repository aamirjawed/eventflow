# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/eventflow
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/eventflow

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
# Generate with: openssl rand -base64 32

# ─── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ─── Admin Whitelist ───────────────────────────────────────────────────────────
# Comma-separated list of admin emails allowed to access the dashboard
ADMIN_EMAILS=admin@example.com,organizer@example.com

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=EventFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
